# Copy to .env. Metro inlines EXPO_PUBLIC_* at bundle time, so after editing
# .env you must restart the bundler with `npx expo start --clear`.
#
# Neither value is a secret. The anon key ships inside the app bundle and is
# extractable by anyone who installs it; RLS (enabled everywhere, zero policies)
# is what makes that safe. See CLAUDE.md.

EXPO_PUBLIC_SUPABASE_URL=https://sbyjkhnvithvluowrzao.supabase.co

